# Optional: custom AWC base (default official FAA AWC Data API)
# AWC_API_BASE=https://aviationweather.gov/api/data
# AWC_USER_AGENT=PilotBriefing/1.0 (+https://github.com/petersphil/pilot-briefing)

# SkyLink NOTAMs via RapidAPI — required for non-Canadian airports
# On cPanel (wx.empressaero.com): set RAPIDAPI_KEY on the Node.js app environment.
# RAPIDAPI_KEY=
# SKYLINK_RAPIDAPI_KEY=   # alternate name; RAPIDAPI_KEY preferred

# Canadian NOTAMs use NAV CANADA CFPS JSON (no API key).

# Dev only: inject sample NOTAMs when SkyLink key is absent (local UI)
# ENABLE_SAMPLE_NOTAMS=1

# Hosting
# PORT=3000
# NODE_ENV=production
