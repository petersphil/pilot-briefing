# Optional: custom AWC base (default official FAA AWC Data API)
# AWC_API_BASE=https://aviationweather.gov/api/data
# AWC_USER_AGENT=PilotBriefing/1.0 (+https://github.com/petersphil/pilot-briefing)

# Optional: FAA NOTAM API (https://api.faa.gov) — required for live US NOTAMs
# FAA_NOTAM_CLIENT_ID=
# FAA_NOTAM_CLIENT_SECRET=
# FAA_NOTAM_TOKEN_URL=https://external-api.faa.gov/oauth2/token
# FAA_NOTAM_API_BASE=https://external-api.faa.gov/notamapi/v1

# Dev only: inject sample NOTAMs when FAA credentials are absent
# ENABLE_SAMPLE_NOTAMS=1

# Hosting
# PORT=3000
# NODE_ENV=production
